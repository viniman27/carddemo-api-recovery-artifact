+def cobol_precondition_failures(cmd: dict[str, Any]) -> list[dict[str, Any]]:
+    """Extract source-level abort cause from COBOL DISPLAY text.
+
+    This does not treat a documented HTTP 500 as success. It records the byte/key
+    precondition that led the COBOL routine to call the local CEE3ABD shim.
+    """
+    events: list[dict[str, Any]] = []
+    lines = (cmd.get("stdout") or "").splitlines()
+    lookup_labels = {
+        "INVALID CARD NUMBER : ": ("CARDXREF", "CBTRN03C DISPLAY before 9999-ABEND-PROGRAM; CARDXREF indexed lookup precondition not met"),
+        "INVALID TRAN TYPE KEY : ": ("TRANTYPE", "CBTRN03C DISPLAY before 9999-ABEND-PROGRAM; TRANTYPE indexed lookup precondition not met"),
+        "INVALID TRAN CATG KEY : ": ("TRANCATG", "CBTRN03C DISPLAY before 9999-ABEND-PROGRAM; TRANCATG indexed lookup precondition not met"),
+    }
+    for idx, line in enumerate(lines):
+        for prefix, (lookup, authority) in lookup_labels.items():
+            if not line.startswith(prefix):
+                continue
+            status = None
+            if idx + 1 < len(lines) and "FILE STATUS IS:" in lines[idx + 1]:
+                raw_status = lines[idx + 1].split("FILE STATUS IS:", 1)[1].strip()
+                status = raw_status[-2:] if len(raw_status) >= 2 else raw_status
+            events.append({
+                "kind": "cobol_precondition_failure",
+                "track": "reporting",
+                "lookup": lookup,
+                "key": line.split(":", 1)[1].strip(),
+                "fileStatus": status,
+                "rawStatusText": lines[idx + 1].strip() if idx + 1 < len(lines) else None,
+                "authority": authority,
+            })
+    return events
+
+
+def reached_cobol_program(cmd: dict[str, Any], program: str, output: bytes | None = None) -> bool:
+    return bool(output) or f"START OF EXECUTION OF PROGRAM {program}" in (cmd.get("stdout") or "") or "END OF EXECUTION" in (cmd.get("stdout") or "")
+
+
